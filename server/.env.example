# ========================================================
# Kiru Leathers Atelier — Server Environment Configuration
# ========================================================

PORT=5000
NODE_ENV=development

# --------------------------------------------------------
# Database Options:
# 1. 'sqlite' (Default, zero-config, embedded file server/data/kiru_atelier.db)
# 2. 'mysql'  (Localhost port 3306 or remote MySQL server)
# 3. 'mongodb' (Local or MongoDB Atlas cluster URI)
# --------------------------------------------------------
DB_TYPE=mysql

# Localhost MySQL Configuration (port 3306)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=kiru_atelier

# MongoDB Configuration (optional)
# MONGODB_URI=mongodb://localhost:27017/kiru_atelier

# Chapa Payment Gateway (optional live keys)
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=

# Google Gemini AI API Key (optional for AI Concierge)
GEMINI_API_KEY=

# JWT Authentication Secret
JWT_SECRET=kiru_atelier_artisan_secret_key_2026
